PORT=3000
NODE_ENV=development

# PostgreSQL (Supabase Free Tier or Render PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# Telegram Bot (Get from @BotFather)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL_ID=""

# Exchange APIs (Read-Only keys; public endpoints work even if empty)
MEXC_API_KEY=""
MEXC_API_SECRET=""
BINANCE_API_KEY=""
BINANCE_API_SECRET=""

# CoinGecko Demo API (Optional for public ping, recommended for higher limits)
COINGECKO_API_KEY=""

# Google Gemini API (For AI agents in Stage 2)
GEMINI_API_KEY=""
