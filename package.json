{
  "name": "cryptoquant-copilot",
  "version": "0.1.0",
  "description": "5-Agent Crypto Signal Bot & Screener (MEXC/Binance/CoinGecko)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "typecheck": "tsc --noEmit",
    "verify:stage0": "tsx scripts/e2e_stage0_verify.ts",
    "verify:stage1": "tsx scripts/e2e_stage1_verify.ts",
    "verify:stage2": "tsx scripts/e2e_stage2_verify.ts",
    "verify:stage3": "tsx scripts/e2e_stage3_verify.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pdfkit": "^0.20.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.7",
    "prisma": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
